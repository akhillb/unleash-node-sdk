{
  "openapi": "3.1.0",
  "info": {
    "title": "Unleash Client API",
    "version": "1.0.0",
    "description": "The endpoints an Unleash SDK calls at runtime."
  },
  "servers": [{ "url": "https://unleash.example.com/api" }],
  "security": [{ "apiKey": [] }],
  "paths": {
    "/client/features": {
      "get": {
        "operationId": "getClientFeatures",
        "summary": "Get client features",
        "description": "Returns every feature flag the supplied API token can evaluate.",
        "tags": ["Client"],
        "parameters": [
          {
            "name": "project",
            "in": "query",
            "required": false,
            "description": "Restrict the response to a single project.",
            "schema": { "type": "string" }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "ETag from a previous response. The server replies 304 when nothing changed.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The current set of feature flags.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClientFeatures" },
                "example": {
                  "version": 2,
                  "features": [
                    { "name": "checkout.new-flow", "type": "release", "enabled": true }
                  ]
                }
              }
            }
          },
          "304": { "description": "Not modified — the supplied ETag is still current." },
          "401": { "description": "The API token is missing or not permitted to connect." }
        }
      }
    },
    "/client/audit": {
      "post": {
        "operationId": "postClientAudit",
        "summary": "Post client audit records",
        "description": "Receives a batch of evaluation records from the SDK's audit sink. The SDK sends a batch when `batchSize` records have accumulated or every `flushIntervalMs` milliseconds, whichever comes first.",
        "tags": ["Client"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuditBatch" },
              "example": {
                "appName": "my-app",
                "instanceId": "my-app-7f9c",
                "records": [
                  {
                    "featureName": "checkout.new-flow",
                    "enabled": true,
                    "timestamp": "2026-08-06T12:00:00Z"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": { "description": "Batch accepted for processing." },
          "400": { "description": "The batch is malformed." },
          "401": { "description": "The API token is missing or not permitted to send audit records." }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": { "type": "apiKey", "in": "header", "name": "Authorization" }
    },
    "schemas": {
      "ClientFeatures": {
        "type": "object",
        "required": ["version", "features"],
        "properties": {
          "version": { "type": "integer" },
          "features": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Feature" }
          }
        }
      },
      "Feature": {
        "type": "object",
        "required": ["name", "enabled"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      },
      "AuditBatch": {
        "type": "object",
        "required": ["appName", "records"],
        "properties": {
          "appName": { "type": "string", "description": "The reporting application's `appName`." },
          "instanceId": { "type": "string", "description": "The SDK instance identifier." },
          "records": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AuditRecord" }
          }
        }
      },
      "AuditRecord": {
        "type": "object",
        "required": ["featureName", "enabled", "timestamp"],
        "properties": {
          "featureName": { "type": "string" },
          "enabled": { "type": "boolean" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
